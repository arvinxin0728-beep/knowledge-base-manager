{
  "schema_version": 1,
  "architecture_style": "modular_monolith",
  "dependency_direction": [
    "interfaces",
    "application",
    "domain",
    "infrastructure"
  ],
  "ratchet_budgets": {
    "SKILL.md": {"max_lines": 500, "target_lines": 250},
    "scripts/kb_manager.py": {"max_lines": 4210, "max_symbols": 168, "target_lines": 800},
    "scripts/kb_pipeline.py": {"max_lines": 880, "max_symbols": 40, "target_lines": 600},
    "scripts/obsidian_linker.py": {"max_lines": 600, "max_symbols": 40, "target_lines": 500},
    "scripts/ebook_probe.py": {"max_lines": 250, "max_symbols": 15, "target_lines": 250}
    ,"scripts/kb_researcher.py": {"max_lines": 230, "max_symbols": 20, "target_lines": 180}
  },
  "legacy_cli_contracts": {
    "scripts/kb_manager.py": [
      "init", "audit", "normalize-index", "promote", "verification-queue",
      "verify-claim", "verification-status", "evaluate-outputs",
      "audit-editorial-quality", "output-review", "record-output-review",
      "audit-assets", "audit-source-quality", "audit-evidence-gaps",
      "init-evidence-intake", "audit-evidence-intake", "audit-lifecycle",
      "audit-knowledge-health", "init-lifecycle-health", "audit-relations",
      "audit-portability", "audit-topic-pages", "audit-filename-dates",
      "normalize-filename-dates", "quality-gate", "gate-10",
      "check-refinement", "sync-relations", "package-lint",
      "validate-config", "doctor", "run"
    ],
    "scripts/kb_pipeline.py": [
      "init", "discover", "prepare", "extract", "claim", "submit",
      "commit", "commit-ready", "fail", "adopt-existing", "retry",
      "cleanup", "migrate-runtime", "retire-legacy-runtime",
      "storage-status", "status"
    ],
    "scripts/kb_researcher.py": [
      "doctor", "init", "list", "register", "registry-init", "select", "show"
    ]
  },
  "allowed_script_dependencies": {
    "ebook_probe.py": [],
    "obsidian_linker.py": [],
    "kb_manager.py": ["obsidian_linker.py", "kb_pipeline.py"],
    "kb_pipeline.py": ["ebook_probe.py", "kb_manager.py"],
    "kb_researcher.py": ["kb_manager.py"]
  },
  "module_dependency_rules": {
    "kbm/domain": ["kbm.platform", "kbm.application", "kbm.infrastructure", "kbm.interfaces", "scripts"],
    "kbm/platform": ["kbm.application", "kbm.interfaces", "scripts"],
    "kbm/application": ["kbm.interfaces", "scripts"]
  },
  "target_modules": {
    "intake": "source discovery, extraction and readability",
    "refinement": "reading protocol, refinement schema and Gate-10",
    "synthesis": "clustering, promotion and topic synthesis",
    "assets": "asset candidates, reusable assets and portfolio balance",
    "publication": "outputs, editorial maturity and publication handoff",
    "governance": "verification, lifecycle, health and quality gates",
    "platform": "configuration, paths, persistence, backups and adapters"
  }
}
